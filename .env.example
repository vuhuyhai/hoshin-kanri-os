# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Resend (auth emails)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
# noreply@resend.dev only works in sandbox mode (limited recipients)
# For production, use a verified domain: noreply@yourdomain.com
RESEND_FROM_EMAIL=Hoshin Kanri OS <noreply@resend.dev>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev only — set to "true" in .env.local to enable /api/auth/dev-login
# NEVER set this in production (Vercel env vars)
# ENABLE_DEV_LOGIN=true

# Dev only — default email for /api/auth/dev-login when no ?email= query param
# Set in .env.local to your local dev account. NEVER set in production.
DEV_LOGIN_DEFAULT_EMAIL=admin@example.com
